{
  // Static assets + a small Worker for /api/* (live Gemini generation, ledger L-163). Build: npm run build.
  // Unlisted: workers.dev URL only, noindex + robots.txt.
  "name": "atria-takehome",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "PER_VISITOR": "10", "PER_DAY": "150", "OWNER_HASH": "a0b8e22cb1649302992c93f43ca78b337b6761de869f5318e3643d05f1443cc4" },
  // Per-visitor and site-wide daily counts for live generation (namespace atria-limits).
  "kv_namespaces": [{ "binding": "LIMITS", "id": "540a04f2ea8d4252b5929d1bd7a0ff02" }]
}
